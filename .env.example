# Copy to .env and fill in values. Server-only vars must not be exposed to the browser.

# --- Supabase (Next.js + worker) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- AI (worker: CV extraction + scoring; Next.js: JD generation) ---
# Google AI Studio API key — new keys use AQ.* (auth keys); legacy keys start with AIza.
# Use the native Gemini API (@google/genai); OpenAI-compatible routes may not accept AQ keys.
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_API_KEYS=key-one,key-two
GROQ_API_KEY=your-groq-api-key
VISION_MODEL=gemini-3.6-flash
REASONING_MODEL=openai/gpt-oss-120b

# --- App URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google Drive OAuth (personal Gmail) ---
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback
# Production (Vercel): GOOGLE_OAUTH_REDIRECT_URI=https://ats-galvan.vercel.app/api/google/callback
# Or set NEXT_PUBLIC_APP_URL=https://ats-galvan.vercel.app and omit GOOGLE_OAUTH_REDIRECT_URI
# GOOGLE_OAUTH_REFRESH_TOKEN=optional; default: Admin → Settings → Connect
# GOOGLE_OAUTH_CONNECT_COOLDOWN_SECONDS=300

# --- Drive stage roots (bootstrap once under Recruitment/ — see AGENTS.md) ---
GOOGLE_DRIVE_INCOMING_ROOT_ID=your-incoming-cvs-folder-id
GOOGLE_DRIVE_MANUAL_REVIEW_ROOT_ID=your-manual-review-folder-id
GOOGLE_DRIVE_ARCHIVE_ROOT_ID=your-archive-folder-id

# --- Worker handoff (Next.js → Railway worker) ---
RAILWAY_WORKER_URL=http://localhost:3001
WORKER_API_SECRET=your-shared-secret
REDIS_URL=redis://localhost:6379

# --- Optional ---
# MAX_AI_RETRIES=3
# WORKER_CONCURRENCY=5
# ALLOW_INSECURE_WORKER=true
# PORT=3001
