# =============================================================================
# App (Next.js / Vercel)
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Supabase
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase (worker uses service role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# =============================================================================
# AI Models (Railway worker — server-only)
# =============================================================================
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
VISION_MODEL=gemini-3.6-flash
REASONING_MODEL=openai/gpt-oss-120b

# =============================================================================
# Google Drive (server-only)
# Stage-first layout — see AGENTS.md section 10
#
# Recruitment/
# ├── Incoming_CVs/          <- GOOGLE_DRIVE_INCOMING_ROOT_ID
# ├── Manual_Review/         <- GOOGLE_DRIVE_MANUAL_REVIEW_ROOT_ID
# └── Archive/               <- GOOGLE_DRIVE_ARCHIVE_ROOT_ID
#
# Job publish creates {job_slug}/ subfolders under each stage root.
# Per-job folder IDs are stored on jobs.incoming_folder_id, etc.
# =============================================================================
# Google Drive — OAuth (personal Gmail; uses your Drive quota)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token

# Redirect URI — add this exact URL in Google Cloud Console → OAuth client
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback

# Optional: paste refresh token manually (otherwise use Admin → Settings → Connect)
# GOOGLE_OAUTH_REFRESH_TOKEN=

# Recruitment/ (bootstrap once)
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-recruitment-root-folder-id

# System stage roots (bootstrap once under Recruitment/)
GOOGLE_DRIVE_INCOMING_ROOT_ID=your-incoming-cvs-root-folder-id
GOOGLE_DRIVE_MANUAL_REVIEW_ROOT_ID=your-manual-review-root-folder-id
GOOGLE_DRIVE_ARCHIVE_ROOT_ID=your-archive-root-folder-id

# =============================================================================
# Worker Queue / Railway
# =============================================================================
# URL of the Railway worker that receives queued AI jobs
RAILWAY_WORKER_URL=https://your-worker.up.railway.app
WORKER_API_SECRET=your-shared-secret-between-vercel-and-railway

# Optional: Redis/BullMQ if using a queue broker
REDIS_URL=redis://localhost:6379

# =============================================================================
# Observability
# =============================================================================
LOG_LEVEL=info

# =============================================================================
# Processing limits
# =============================================================================
MAX_AI_RETRIES=3
WORKER_CONCURRENCY=5
